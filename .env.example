# mock = complete browser demo; supabase = private live posts/opportunities; api = teammate API.
# Restart Next.js after changing these.
NEXT_PUBLIC_DATA_MODE=mock
# In api mode, a same-origin proxy is recommended; empty means this Next.js origin.
NEXT_PUBLIC_API_BASE_URL=

# Supabase mode: use only the publishable key from the project's Connect panel.
# Never put a secret / service_role key in NEXT_PUBLIC_ variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_WORKSPACE_ID=localy
